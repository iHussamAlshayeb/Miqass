NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/miqass
JWT_SECRET=change_me
SUPER_ADMIN_SECRET=change_me
ENCRYPTION_KEY=change_me
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
REDIS_URL=redis://127.0.0.1:6379

# Resend: https://resend.com/api-keys — يجب توثيق دومين FROM_EMAIL في Resend
RESEND_API_KEY=
FROM_NAME=Miqass App
FROM_EMAIL=noreply@miqass.app
# اختياري: عنوان استقبال الردود
REPLY_TO_EMAIL=

MOYASAR_SECRET_KEY=
WASENDER_MASTER_TOKEN=
# Whatsi (وسيط واتساب ثاني) - مفتاح التكامل وسر الـ Webhook من لوحة Whatsi
WHATSI_BASE_URL=https://whatsi.ihussam.dev
WHATSI_INTEGRATION_KEY=
WHATSI_WEBHOOK_SECRET=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
ZATCA_BASE_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal
ZAKATY_BASE_URL=
ZAKATY_PROVISIONING_CONFIG_FILE=
ZAKATY_PROVISIONING_API_KEY=
ZAKATY_PROVISIONING_ENVIRONMENT=production

# سياسة أمان المحتوى: report (مراقبة فقط) | enforce (منع) | off
CSP_MODE=report
